{
  "name": "@open-panel/action-engine",
  "version": "0.1.0",
  "description": "Action registry and execution engine for OpenPanel, plus the built-in actions: shell, hotkeys, open app/URL, page navigation, folders, multimedia keys and profile switching.",
  "type": "module",
  "license": "MIT",
  "author": "OpenPanel contributors",
  "homepage": "https://github.com/open-panel/package-action-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-panel/package-action-engine.git"
  },
  "bugs": {
    "url": "https://github.com/open-panel/package-action-engine/issues"
  },
  "keywords": [
    "openpanel",
    "macropad",
    "stream-deck",
    "actions",
    "automation"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@open-panel/shared": "^0.1.0",
    "open": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
